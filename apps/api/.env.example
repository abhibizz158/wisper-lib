# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL connection string
# run.sh reuses your DATABASE_URL. Without an existing .env, it prepares
# PostgreSQL 17 through Docker with generated credentials and persistent storage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wisperlib

# ─── File storage ─────────────────────────────────────────────────────────────
# Directory for uploaded book files, covers, and whisper audio
# Relative to apps/api or use an absolute path
UPLOADS_DIR=./uploads

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# ─── Amazon Polly (optional) ──────────────────────────────────────────────────
# Optional cloud service; check your AWS account eligibility and current pricing.
# Credentials are not required for local startup; the planned whisper route
# will offer a text-only fallback.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=standard
POLLY_LOCALE=en-US

# Optional launcher controls (also accepted as environment variables)
# WEB_PORT=5173
# API_PORT=3001
# DB_PORT=5432  # used only when creating a new managed Docker database
