{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "dotenv -e .env -- node-pg-migrate up --migrations-dir ./migrations",
    "db:migrate:down": "dotenv -e .env -- node-pg-migrate down --migrations-dir ./migrations",
    "db:reset": "dotenv -e .env -- node ./scripts/db-reset.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "3.758.0",
    "@fastify/cors": "10.0.2",
    "@fastify/multipart": "9.0.3",
    "@fastify/static": "8.1.1",
    "@wisper-lib/shared-types": "workspace:*",
    "cheerio": "1.0.0",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "fflate": "0.8.2",
    "node-pg-migrate": "7.9.1",
    "pdfjs-dist": "4.10.38",
    "pg": "8.14.1",
    "pino-pretty": "13.0.0",
    "yauzl": "3.2.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/yauzl": "2.10.3",
    "dotenv-cli": "8.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
